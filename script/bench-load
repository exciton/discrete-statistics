#!/usr/bin/env bash
# Load a bench SQLite database into MariaDB or Postgres.
#
#   script/bench-load <variant> <mariadb|postgres> [sqlite db] [--states] [...]
#
# The database defaults to $BENCH_DATA/<variant>/home-assistant_v2.db, the
# same file `script/bench <variant> sqlite` measures. Remaining arguments
# go to bench/load.py: `--states` also copies the configured entities'
# `states` rows (needed by the `build` and `compile` modes), `--only
# stats|states` loads one half, `--verify-only` re-checks what is there.
#
# The target database must exist and hold Home Assistant's schema:
# `script/bench-db up` creates it empty, `script/bench <variant> <engine>
# schema` fills in the DDL by booting the recorder against it.
set -euo pipefail

IMAGE=ha-discrete-stats-bench
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA="$(readlink -f "${BENCH_DATA:-$REPO_ROOT/bench/data}")"

VARIANT="${1:?usage: script/bench-load <variant> <mariadb|postgres> [db] [--states]}"
ENGINE="${2:?usage: script/bench-load <variant> <mariadb|postgres> [db] [--states]}"
shift 2
SOURCE="$DATA/$VARIANT/home-assistant_v2.db"
if [[ "${1:-}" != "" && "${1:0:2}" != "--" ]]; then SOURCE="$1"; shift; fi
SOURCE="$(readlink -f "$SOURCE")"
[[ -f "$SOURCE" ]] || { echo "no database at $SOURCE" >&2; exit 1; }

case "$ENGINE" in
  mariadb)  URL="mysql+pymysql://bench:bench@127.0.0.1:${BENCH_MARIADB_PORT:-3307}/$VARIANT" ;;
  postgres) URL="postgresql://bench:bench@127.0.0.1:${BENCH_POSTGRES_PORT:-5433}/$VARIANT" ;;
  *) echo "engine must be mariadb or postgres" >&2; exit 1 ;;
esac

# Both directories are bound at their own paths, so what the loader is
# told on the command line is what it opens.
exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  --network host \
  -v "$REPO_ROOT:/workspace" \
  -v "$(dirname "$SOURCE"):$(dirname "$SOURCE")" \
  -v "$DATA:$DATA" \
  -w /workspace \
  "$IMAGE" \
  python bench/load.py \
    --source "$SOURCE" \
    --entries "$DATA/entries.json" \
    --target "$URL" "$@"
